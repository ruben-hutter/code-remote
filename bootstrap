#!/usr/bin/env bash
# Entry point for the ssh-first flow:
#   ssh <host>                                   # first time, manual
#   git clone https://github.com/ruben-hutter/code-remote
#   cd code-remote && ./bootstrap                # full setup (all)
# Credentials (pi keys, passenv) are NOT part of this — run
# `bin/code-remote <alias> sync` from your machine afterwards, once.
# Updates later: git pull in this repo, ~/nixos-config and ~/.agents/skills
# are updated automatically by the script, then re-run ./bootstrap.
exec "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/remote/bootstrap.sh" "${1:-all}"
