#!/usr/bin/env bash
# code-remote — one command: provision a userspace dev environment on a
# remote host over plain ssh, then push the data/credentials only this
# machine can provide (pass). The host clones this repo (public GitHub, no
# keys) and runs remote/bootstrap.sh (nix + home-manager + pi); everything
# declarative lives in flake.nix + home/. Connect afterwards with plain ssh
# or your own tool (e.g. pxc).
#
# usage:
#   code-remote <ssh-alias>    full setup: repo on host + nix/HM/pi + keys
#
# Idempotent — re-run any time to update the host and re-sync credentials.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=code-remote.conf
source "$DIR/code-remote.conf"

[ $# -eq 1 ] || { echo "usage: code-remote <ssh-alias>" >&2; exit 1; }
HOST="$1"

info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }

# --- data + credentials config, pushed BEFORE the bootstrap runs --------------
# so `pi update --extensions` during bootstrap reconciles against the CURRENT
# settings.json/extensions. Secrets are resolved LOCALLY (pass) — they can
# never come from the public GitHub clones the host makes.
push_data_configs() {
  local f

  ssh "$HOST" 'mkdir -p ~/.pi/agent'

  # pi: config-level files only; sessions/, install/, npm/, bin/ never leave here
  for f in "${PI_FILES[@]}"; do
    if [ -e "$HOME/.pi/agent/$f" ]; then
      rsync -az "$HOME/.pi/agent/$f" "$HOST:.pi/agent/"
    fi
  done
  rsync -az --delete "${PI_EXCLUDES[@]}" \
    "$HOME/.pi/agent/extensions/" "$HOST:.pi/agent/extensions/"
  rsync -az --delete "$HOME/.pi/agent/agents/" "$HOST:.pi/agent/agents/"

  # personal aliases — plain data, sourced by the HM-generated .bashrc
  if [ -f "$HOME/.bashrc-personal" ]; then
    rsync -az "$HOME/.bashrc-personal" "$HOST:.bashrc-personal"
  fi

  # env vars for providers that read the environment (PASS_ENVARS), resolved
  # from pass LOCALLY and written as a plain env file sourced by .bashrc
  if [ "${#PASS_ENVARS[@]}" -gt 0 ]; then
    local line var entry val envtmp
    envtmp="$(mktemp)"
    {
      echo "# generated by code-remote — do not edit; resolved from pass at sync time"
      for line in "${PASS_ENVARS[@]}"; do
        var="${line%%:*}"; entry="${line#*:}"
        val="$(pass show "$entry" 2>/dev/null | head -n 1 | tr -d '\r')"
        if [ -n "$val" ]; then
          printf "export %s='%s'\n" "$var" "$(printf '%s' "$val" | sed "s/'/'\\''/g")"
        else
          info "passenv: pass show $entry failed — $var not set"
        fi
      done
    } > "$envtmp"
    ssh "$HOST" 'mkdir -p ~/.config/code-remote'
    rsync -az "$envtmp" "$HOST:.config/code-remote/passenv"
    rm -f "$envtmp"
  fi
}

# --- pi API keys, pushed AFTER the bootstrap (pi must exist) ------------------
# auth.json stores keys as "!command" values (they call `pass` locally,
# which does not exist on remotes). Build a resolved copy in PI_AUTH_RESOLVED:
# literal keys written; credentials that exist only on the remote are
# preserved (e.g. OAuth logins done there).
resolve_pi_keys() {
  PI_AUTH_RESOLVED=""
  [ -f "$HOME/.pi/agent/auth.json" ] || return 0
  PI_AUTH_RESOLVED="$(mktemp)"
  chmod 600 "$PI_AUTH_RESOLVED"
  if ssh "$HOST" 'test -f ~/.pi/agent/auth.json' 2>/dev/null; then
    ssh "$HOST" 'cat ~/.pi/agent/auth.json' > "$PI_AUTH_RESOLVED" # keep remote-only creds
  else
    cp "$HOME/.pi/agent/auth.json" "$PI_AUTH_RESOLVED"
  fi
  local p cmd key tmpm providers
  providers="$(jq -r 'to_entries[] | select(.value.type == "api_key" and (.value.key | startswith("!"))) | .key' \
    "$HOME/.pi/agent/auth.json" 2>/dev/null)" || return 0
  [ -n "$providers" ] || return 0
  while IFS= read -r p; do
    cmd="$(jq -r --arg p "$p" '.[$p].key[1:]' "$HOME/.pi/agent/auth.json")"
    key="$(bash -c "$cmd" 2>/dev/null | head -n 1 | tr -d '\r')"
    if [ -z "$key" ]; then
      info "pi keys: could not resolve $p — left as-is"
      continue
    fi
    tmpm="$PI_AUTH_RESOLVED.m"
    jq --arg p "$p" --arg k "$key" '.[$p].type = "api_key" | .[$p].key = $k' "$PI_AUTH_RESOLVED" > "$tmpm" && mv "$tmpm" "$PI_AUTH_RESOLVED"
    info "pi keys: $p resolved from pass"
  done <<< "$providers"
}

push_pi_keys() {
  [ -n "${PI_AUTH_RESOLVED:-}" ] || return 0
  # Never the raw file: "!pass" commands cannot work on the remote (no pass).
  if ssh "$HOST" 'test -f ~/.pi/agent/auth.json' 2>/dev/null; then
    rsync -az "$PI_AUTH_RESOLVED" "$HOST:.pi/agent/auth.json" # merge-updated in resolve_pi_keys
  elif [ "$SYNC_PI_AUTH" = "1" ]; then
    rsync -az "$PI_AUTH_RESOLVED" "$HOST:.pi/agent/auth.json"
    info "auth.json seeded (remote had none)"
  else
    info "auth.json: not seeded (SYNC_PI_AUTH=0)"
  fi
  rm -f "$PI_AUTH_RESOLVED"; PI_AUTH_RESOLVED=""
}

# --- the one flow -------------------------------------------------------------
if ! ssh "$HOST" 'test -d ~/code-remote/.git' 2>/dev/null; then
  info "cloning code-remote on $HOST"
  ssh "$HOST" "git clone -q '$CODE_REMOTE_REPO' ~/code-remote" \
    || { echo "clone failed — is $CODE_REMOTE_REPO reachable from the host?" >&2; exit 1; }
fi

info "pushing data + config to $HOST"
push_data_configs

info "running bootstrap on $HOST (nix + home-manager + pi)"
ssh -t "$HOST" 'cd ~/code-remote && git pull --ff-only -q && bash remote/bootstrap.sh'

resolve_pi_keys
push_pi_keys

info "done — $HOST is ready (connect: ssh $HOST, or your own tool)"
