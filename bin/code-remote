#!/usr/bin/env bash
# code-remote — provision and use a userspace dev environment on a remote host
# over plain ssh. The bootstrap is REMOTE-DRIVEN: the host clones this repo
# (public GitHub, no keys) and runs remote/bootstrap.sh, which also clones
# ~/repos/nixos-config + skills and activates the home-manager generation.
# This local wrapper is the one-liner version of that, plus `sync` for the
# data/credentials only your machine can provide (pass), plus `connect`.
#
# usage:
#   code-remote <ssh-alias>                  connect (default command)
#   code-remote <ssh-alias> bootstrap        full setup: nix + home-manager + pi
#   code-remote <ssh-alias> sync             re-push configs, re-run home-manager
#   code-remote <ssh-alias> connect [args]   ssh + tmux session manager (or attach)
#   extra args after the command are passed through to ssh
#   legacy order (code-remote <command> <ssh-alias>) still accepted
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=code-remote.conf
source "$DIR/code-remote.conf"

usage() {
  cat >&2 <<'EOF'
usage: code-remote <ssh-alias>                 connect (default command)
       code-remote <ssh-alias> bootstrap       clone/pull repo on host + full setup (nix, home-manager, pi)
       code-remote <ssh-alias> sync            push data + credentials (pi keys, passenv, aliases)
       code-remote <ssh-alias> connect [args]  ssh + tmux session picker (or attach)

  bootstrap is remote-driven: the host clones https://github.com/ruben-hutter/code-remote
  and runs it; this command is the one-liner version. Run 'sync' once after
  bootstrap — credentials (pi keys, passenv) can only come from this machine.
  Extra args after the command are forwarded to ssh (e.g. port forwards).
  Legacy order still accepted: code-remote <bootstrap|sync|connect> <ssh-alias>
EOF
  exit 1
}

is_cmd() { case " bootstrap sync connect " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

[ $# -ge 1 ] || usage
CMD="connect"
if is_cmd "$1" && [ $# -ge 2 ]; then
  CMD="$1"; HOST="$2"; shift 2
else
  HOST="$1"; shift
  if [ $# -ge 1 ]; then CMD="$1"; shift; fi
fi
is_cmd "$CMD" || { echo "unknown command: $CMD" >&2; usage; }
EXTRA=()
[ $# -gt 0 ] && EXTRA=("$@")
# every ssh call goes through rc() so extra args (e.g. -L forwards) apply everywhere
rc() { ssh ${EXTRA[@]+"${EXTRA[@]}"} "$@"; }

info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }

# pi keys: auth.json stores them as "!command" values (they call `pass` locally,
# which does not exist on remotes). Build a resolved copy in PI_AUTH_RESOLVED:
# literal keys written; credentials that exist only on the remote are preserved
# (e.g. OAuth logins done there).
resolve_pi_keys() {
  PI_AUTH_RESOLVED=""
  [ -f "$HOME/.pi/agent/auth.json" ] || return 0
  PI_AUTH_RESOLVED="$(mktemp)"
  chmod 600 "$PI_AUTH_RESOLVED"
  if rc "$HOST" 'test -f ~/.pi/agent/auth.json' 2>/dev/null; then
    rc "$HOST" 'cat ~/.pi/agent/auth.json' > "$PI_AUTH_RESOLVED" # keep remote-only creds
  else
    cp "$HOME/.pi/agent/auth.json" "$PI_AUTH_RESOLVED"
  fi
  local p cmd key tmpm providers
  providers="$(jq -r 'to_entries[] | select(.value.type == "api_key" and (.value.key | startswith("!"))) | .key' \
    "$HOME/.pi/agent/auth.json" 2>/dev/null)" || return 0
  [ -n "$providers" ] || return 0
  while IFS= read -r p; do
    cmd="$(jq -r --arg p "$p" '.[$p].key[1:]' "$HOME/.pi/agent/auth.json")"
    key="$(bash -c "$cmd" 2>/dev/null | head -n 1 | tr -d '\r')"
    if [ -z "$key" ]; then
      info "pi keys: could not resolve $p — left as-is"
      continue
    fi
    tmpm="$PI_AUTH_RESOLVED.m"
    jq --arg p "$p" --arg k "$key" '.[$p].type = "api_key" | .[$p].key = $k' "$PI_AUTH_RESOLVED" > "$tmpm" && mv "$tmpm" "$PI_AUTH_RESOLVED"
    info "pi keys: $p resolved from pass"
  done <<< "$providers"
}

sync_pi_keys() {
  [ -n "${PI_AUTH_RESOLVED:-}" ] || return 0
  rc "$HOST" 'test -f ~/.pi/agent/auth.json' 2>/dev/null || return 0
  rsync -az "$PI_AUTH_RESOLVED" "$HOST:.pi/agent/auth.json"
  rm -f "$PI_AUTH_RESOLVED"; PI_AUTH_RESOLVED=""
}

push_data_configs() {
  # Everything the remote git clones do NOT carry: user data + credentials
  # synced from this machine. (Code itself — bootstrap repo, nixos-config,
  # skills — lives in public GitHub clones on the host, updated by the
  # bootstrap script; secrets can never come from a repo, only from here.)
  local r="$HOST" f

  # personal aliases — plain data, sourced by the HM-generated .bashrc
  if [ -f "$HOME/.bashrc-personal" ]; then
    rsync -az "$HOME/.bashrc-personal" "$r:.bashrc-personal"
  fi

  # pi: config-level files only; sessions/, install/, npm/, bin/ never leave here
  for f in "${PI_FILES[@]}"; do
    if [ -e "$HOME/.pi/agent/$f" ]; then
      rsync -az "$HOME/.pi/agent/$f" "$r:.pi/agent/"
    fi
  done
  rsync -az --delete "${PI_EXCLUDES[@]}" \
    "$HOME/.pi/agent/extensions/" "$r:.pi/agent/extensions/"
  rsync -az --delete "$HOME/.pi/agent/agents/" "$r:.pi/agent/agents/"

  # env vars for providers that read the environment (PASS_ENVARS), resolved
  # from pass LOCALLY and written as a plain env file sourced by .bashrc
  if [ "${#PASS_ENVARS[@]}" -gt 0 ]; then
    local line var entry val envtmp
    envtmp="$(mktemp)"
    {
      echo "# generated by code-remote — do not edit; resolved from pass at sync time"
      for line in "${PASS_ENVARS[@]}"; do
        var="${line%%:*}"; entry="${line#*:}"
        val="$(pass show "$entry" 2>/dev/null | head -n 1 | tr -d '\r')"
        if [ -n "$val" ]; then
          printf "export %s='%s'\n" "$var" "$(printf '%s' "$val" | sed "s/'/'\\''/g")"
        else
          info "passenv: pass show $entry failed — $var not set"
        fi
      done
    } > "$envtmp"
    rc "$r" 'mkdir -p ~/.config/code-remote'
    rsync -az "$envtmp" "$r:.config/code-remote/passenv"
    rm -f "$envtmp"
  fi

  resolve_pi_keys
  sync_pi_keys # remote already has auth.json → push resolved merge
  # seed: remote has NO auth.json → push the resolved copy. Never the raw file:
  # "!pass" commands cannot work on the remote (no pass there).
  if [ -n "${PI_AUTH_RESOLVED:-}" ]; then
    if rc "$r" 'test -f ~/.pi/agent/auth.json' 2>/dev/null; then
      info "auth.json: remote keeps its own credentials"
    elif [ "$SYNC_PI_AUTH" = "1" ]; then
      rsync -az "$PI_AUTH_RESOLVED" "$r:.pi/agent/auth.json"
      info "auth.json pushed resolved (remote had none)"
    fi
    rm -f "$PI_AUTH_RESOLVED"; PI_AUTH_RESOLVED=""
  fi
}

case "$CMD" in
  bootstrap)
    # Remote-driven bootstrap: the host clones/pulls this repo and runs the
    # script itself (which also clones nixos-config + skills). This local
    # command is just the one-liner version of the manual ssh+clone+./bootstrap.
    if ! rc "$HOST" 'test -d ~/code-remote/.git' 2>/dev/null; then
      info "cloning code-remote on $HOST"
      rc "$HOST" "git clone -q '$CODE_REMOTE_REPO' ~/code-remote" \
        || { echo "clone failed — is $CODE_REMOTE_REPO reachable from the host?" >&2; exit 1; }
    fi
    info "updating + running bootstrap on $HOST (nix + home-manager + pi)"
    rc -t "$HOST" 'cd ~/code-remote && git pull --ff-only -q && bash remote/bootstrap.sh all'
    info "done — run 'bin/code-remote $HOST sync' once for pi keys/passenv, then connect"
    ;;
  sync)
    # data + credentials only: pi configs/keys, passenv, bashrc-personal.
    # Code + configs live in git clones ON the host (code-remote, nixos-config,
    # skills); update them with bin/code-remote <host> bootstrap or manually.
    push_data_configs
    info "done"
    ;;
  connect)
    # PATH set explicitly: the ssh command runs a non-interactive shell that
    # may not source .profile (nix profile) — ~/.local/bin (pi, shims),
    # ~/.nix-profile/bin (HM tools) and ~/scripts must be visible regardless
    if rc "$HOST" 'test -x ~/scripts/tmux_session_manager.sh' 2>/dev/null; then
      rc -t "$HOST" 'export PATH="$HOME/.local/bin:$HOME/.nix-profile/bin:$HOME/scripts:$PATH"; exec ~/scripts/tmux_session_manager.sh'
      exit $?
    fi
    rc -t "$HOST" 'export PATH="$HOME/.local/bin:$HOME/.nix-profile/bin:$HOME/scripts:$PATH"; tmux new-session -A -s '"$TMUX_SESSION"
    ;;
  *)
    usage
    ;;
esac
