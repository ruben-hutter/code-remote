#!/usr/bin/env bash
# code-remote — provision a userspace dev environment on a remote host over
# plain ssh: clone this repo on the host, run remote/bootstrap.sh (nix +
# home-manager + pi), and push the data/credentials only this machine can
# provide (resolved from local pass). Idempotent — re-run any time to update
# the host and re-sync credentials. See README.md for the full picture.
#
# usage: code-remote <ssh-alias>
set -euo pipefail

# --- fixed config -------------------------------------------------------------
REPO="https://github.com/ruben-hutter/code-remote"
# pass entry holding the GitHub PAT (classic with repo/read:org, or
# fine-grained with the repos you need)
GH_PASS_ENTRY="github/pat"
# pi config-level files only; sessions/, install/, npm/, bin/ never leave here
PI_FILES=(settings.json keybindings.json AGENTS.md trust.json models-store.json)
# extensions that stay LOCAL ONLY (notify.ts: no notifications on remotes)
PI_EXCLUDES=(--exclude=gondolin --exclude=blink1.ts --exclude=notify.ts)

[ $# -eq 1 ] || { echo "usage: code-remote <ssh-alias>" >&2; exit 1; }
HOST="$1"

info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m  ✓\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m  !\033[0m %s\n' "$*"; }

# --- data + config, pushed BEFORE the bootstrap -------------------------------
# so `pi update --extensions` during bootstrap reconciles against the current
# settings.json/extensions. Secrets never travel here — only from local pass.
push_data_configs() {
  local f

  ssh -n "$HOST" 'mkdir -p ~/.pi/agent'

  for f in "${PI_FILES[@]}"; do
    if [ -e "$HOME/.pi/agent/$f" ]; then
      rsync -az "$HOME/.pi/agent/$f" "$HOST:.pi/agent/"
    fi
  done
  rsync -az --delete "${PI_EXCLUDES[@]}" \
    "$HOME/.pi/agent/extensions/" "$HOST:.pi/agent/extensions/"
  rsync -az --delete "$HOME/.pi/agent/agents/" "$HOST:.pi/agent/agents/"

  # hosts here are Debian/Ubuntu — rewrite the Fedora-flavored `upal` alias
  # (dnf) for apt in the PUSHED copy only (the local file stays untouched)
  if [ -f "$HOME/.bashrc-personal" ]; then
    local brc
    brc="$(mktemp)"
    sed 's|^alias upal=.*|alias upal="sudo apt update \&\& sudo apt upgrade"|' \
      "$HOME/.bashrc-personal" > "$brc"
    rsync -az "$brc" "$HOST:.bashrc-personal"
    rm -f "$brc"
  fi
}

# --- pi API keys, pushed AFTER the bootstrap ----------------------------------
# auth.json stores keys as "!command" values that call local `pass` (absent on
# remotes) — resolve them to literal keys. Credentials that exist only on the
# remote (e.g. OAuth logins done there) are preserved via merge.
resolve_pi_keys() {
  PI_AUTH_RESOLVED=""
  [ -f "$HOME/.pi/agent/auth.json" ] || return 0
  PI_AUTH_RESOLVED="$(mktemp)"
  chmod 600 "$PI_AUTH_RESOLVED"
  if ssh -n "$HOST" 'test -f ~/.pi/agent/auth.json' 2>/dev/null; then
    ssh -n "$HOST" 'cat ~/.pi/agent/auth.json' > "$PI_AUTH_RESOLVED" # keep remote-only creds
  else
    cp "$HOME/.pi/agent/auth.json" "$PI_AUTH_RESOLVED"
  fi
  local p cmd key tmpm providers
  providers="$(jq -r 'to_entries[] | select(.value.type == "api_key" and (.value.key | startswith("!"))) | .key' \
    "$HOME/.pi/agent/auth.json" 2>/dev/null)" || return 0
  [ -n "$providers" ] || return 0
  while IFS= read -r p; do
    cmd="$(jq -r --arg p "$p" '.[$p].key[1:]' "$HOME/.pi/agent/auth.json")"
    key="$(bash -c "$cmd" 2>/dev/null | head -n 1 | tr -d '\r')"
    if [ -z "$key" ]; then
      info "pi keys: could not resolve $p — left as-is"
      continue
    fi
    tmpm="$PI_AUTH_RESOLVED.m"
    jq --arg p "$p" --arg k "$key" '.[$p].type = "api_key" | .[$p].key = $k' "$PI_AUTH_RESOLVED" > "$tmpm" && mv "$tmpm" "$PI_AUTH_RESOLVED"
    info "pi keys: $p resolved from pass"
  done <<< "$providers"
}

push_pi_keys() {
  [ -n "${PI_AUTH_RESOLVED:-}" ] || return 0
  if ssh -n "$HOST" 'test -f ~/.pi/agent/auth.json' 2>/dev/null; then
    rsync -az "$PI_AUTH_RESOLVED" "$HOST:.pi/agent/auth.json" # merge-updated in resolve_pi_keys
  elif [ "${SEED_AUTH:-}" = 1 ]; then
    rsync -az "$PI_AUTH_RESOLVED" "$HOST:.pi/agent/auth.json"
    info "auth.json seeded (remote had none)"
  else
    info "auth.json: not seeded — remote has no keys"
  fi
  rm -f "$PI_AUTH_RESOLVED"; PI_AUTH_RESOLVED=""
}

# --- gh token, pushed AFTER the bootstrap -------------------------------------
# gh is a pure HTTPS API client — the remote's SSH key plays no part — so it
# needs its own token, resolved locally from pass. Re-running re-pushes, so
# token rotations propagate.
resolve_gh_token() {
  GH_TOKEN_RESOLVED=""
  if ! command -v pass >/dev/null 2>&1; then
    warn "gh token: no pass locally — skipping"
    return 0
  fi
  GH_TOKEN_RESOLVED="$(pass show "$GH_PASS_ENTRY" 2>/dev/null | head -n 1 | tr -d '\r')" || GH_TOKEN_RESOLVED=""
  [ -n "$GH_TOKEN_RESOLVED" ] && return 0
  GH_TOKEN_RESOLVED=""
  warn "gh token: pass entry '$GH_PASS_ENTRY' missing/empty — skipping (create it: pass insert $GH_PASS_ENTRY)"
}

push_gh_token() {
  [ -n "${GH_TOKEN_RESOLVED:-}" ] || return 0
  # NO `ssh -n` — the token travels on stdin. And `ssh host cmd` is a
  # non-login shell (no .profile), so gh's profile dir must go on PATH by hand.
  if printf '%s\n' "$GH_TOKEN_RESOLVED" | ssh "$HOST" \
      'export PATH="$HOME/.nix-profile/bin:$PATH"; gh auth login --with-token' >/dev/null 2>&1; then
    ok "gh authenticated (verify on $HOST: gh auth status)"
  else
    warn "gh auth failed — check token validity/scopes on $HOST"
  fi
  GH_TOKEN_RESOLVED=""
}

# --- the one flow -------------------------------------------------------------
if ! ssh -n "$HOST" 'test -d ~/code-remote/.git' 2>/dev/null; then
  info "cloning code-remote on $HOST"
  ssh -n "$HOST" "git clone -q '$REPO' ~/code-remote" \
    || { echo "clone failed — is $REPO reachable from the host?" >&2; exit 1; }
fi

# ask ONCE, up front: seeding writes pi API keys onto the remote; existing
# remotes are always merge-updated silently (no question needed)
SEED_AUTH=0
if ! ssh -n "$HOST" 'test -f ~/.pi/agent/auth.json' 2>/dev/null; then
  printf 'seed pi API keys (auth.json, resolved from local pass) to %s? [y/N] ' "$HOST"
  read -r answer || answer=""
  case "$answer" in [Yy]*) SEED_AUTH=1 ;; esac
fi

info "pushing data + config to $HOST"
push_data_configs

info "running bootstrap on $HOST (nix + home-manager + pi)"
ssh -t "$HOST" 'cd ~/code-remote && git pull --ff-only -q && bash remote/bootstrap.sh'

resolve_pi_keys
push_pi_keys
resolve_gh_token
push_gh_token

info "done — $HOST is ready (connect: ssh $HOST, or your own tool)"
