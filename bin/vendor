#!/usr/bin/env bash
# Re-vendor the desktop-owned configs into this repo. The canonical copies
# live in ~/repos/nixos-config (the desktop/NixOS config); the remote profile
# mirrors the ones it needs. Run this after changing nvim/starship/lf/btop/
# htop on the desktop, then commit + push THIS repo and re-run ./bootstrap
# on the hosts.
#
# usage: bin/vendor [path-to-nixos-config-checkout]
#        (default: ~/repos/nixos-config/master)
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SRC="${1:-$HOME/repos/nixos-config/master}"

[ -d "$SRC/home/programs/nvim" ] || { echo "nixos-config checkout not found: $SRC" >&2; exit 1; }

rsync -a --delete --exclude='*.un~' "$SRC/home/programs/nvim/" "$DIR/home/nvim/"
cp "$SRC/home/programs/assets/starship.toml" \
   "$SRC/home/programs/assets/lfrc" \
   "$SRC/home/programs/assets/btop.conf" \
   "$SRC/home/programs/assets/htoprc" \
   "$DIR/home/assets/"

echo "vendored from $SRC:"
git -C "$DIR" status --short home/
echo "review, commit + push this repo, then re-run ./bootstrap on the hosts"
