#!/bin/sh
# code-remote: OSC notify shim for headless hosts.
# pi's notify extension calls notify-send when a prompt needs attention;
# hosts with no notification daemon get this shim instead (installed by
# bootstrap.sh). Delivery is best-effort to the terminal pi runs on:
#   - plain ssh: OSC 9 / OSC 777 escape to /dev/tty — terminals with desktop
#     notification support (kitty, wezterm, iTerm2, rxvt-unicode, …) surface
#     it on your LOCAL machine, over the wire
#   - inside tmux: same escapes DCS-wrapped (needs allow-passthrough on,
#     discarded harmlessly otherwise) + a tmux status-line message, which is
#     always visible in the attached session
# Escapes go to /dev/tty, never stdout: pi spawns this with stdio ignored,
# and CLI callers shouldn't have OSC bytes land in their pipes.
# If a real notify-send shows up on the system later, defer to it.
for d in /usr/bin /usr/local/bin /bin; do
    [ -x "$d/notify-send" ] && exec "$d/notify-send" "$@"
done

# notify-send CLI: options first (--app-name=…, --icon=…, --transient, …),
# then summary, then optional body. Keep only what we can display.
summary=""; body=""
for a in "$@"; do
    case "$a" in
        --*) ;;
        *)  if [ -z "$summary" ]; then summary="$a"; else body="$a"; fi ;;
    esac
done
[ -n "$summary" ] || exit 0

# strip control characters so message content can't forge escape sequences
title=$(printf '%s' "$summary" | tr -d '\000-\037\177')
text=$(printf '%s' "$body" | tr -d '\000-\037\177')

# only emit when we really have a controlling terminal ([ -w ] checks
# permissions, not that the open would succeed — pi runs us with stdio
# ignored, but /dev/tty still reaches the terminal pi runs on)
if { true > /dev/tty; } 2>/dev/null; then
    if [ -n "${TMUX:-}" ]; then
        # DCS tmux; passthrough wrapper — ESCs inside the payload are doubled
        { printf '\033Ptmux;\033\033]9;%s\007\033\033]777;notify;%s;%s\033\033\\\033\\' \
            "$title" "$title" "$text" > /dev/tty; } 2>/dev/null
    else
        { printf '\033]9;%s\007\033]777;notify;%s;%s\033\\' \
            "$title" "$title" "$text" > /dev/tty; } 2>/dev/null
    fi
fi

# status line is the always-works channel under tmux (-d: linger 5s)
[ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1 &&
    tmux display-message -d 5000 "$title${text:+ — $text}" >/dev/null 2>&1

exit 0
